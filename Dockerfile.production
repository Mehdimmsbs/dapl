FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

# Build placeholders only; never use production credentials here.
RUN DATABASE_URL="mysql://build:build@127.0.0.1:3306/dapl" \
    SHADOW_DATABASE_URL="mysql://build:build@127.0.0.1:3306/dapl_shadow" \
    npx prisma generate --config prisma7.config.ts

RUN DATABASE_URL="mysql://build:build@127.0.0.1:3306/dapl" \
    SHADOW_DATABASE_URL="mysql://build:build@127.0.0.1:3306/dapl_shadow" \
    BETTER_AUTH_URL="https://build.invalid" \
    BETTER_AUTH_SECRET="build-only-placeholder-not-a-production-secret-123456789" \
    npm run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Keep Prisma CLI available for the separate migration command.
COPY --from=build --chown=node:node /app /app

USER node

EXPOSE 3000

CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0"]